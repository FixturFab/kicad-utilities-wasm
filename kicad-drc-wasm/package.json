{
  "name": "kicad-wasm-utilities",
  "version": "0.1.0",
  "description": "KiCad PCB/schematic validation, STEP export, and Specctra DSN/SES via WebAssembly",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/kicad-wasm-utilities"
  },
  "keywords": [
    "kicad",
    "pcb",
    "wasm",
    "webassembly",
    "drc",
    "erc",
    "step",
    "specctra"
  ],
  "type": "module",
  "main": "build-wasm-erc/kicad_drc.mjs",
  "types": "types/kicad-wasm.d.ts",
  "exports": {
    ".": {
      "import": "./build-wasm-erc/kicad_drc.mjs",
      "types": "./types/kicad-wasm.d.ts"
    },
    "./step-export": {
      "import": "./src/step-export/index.mjs",
      "types": "./types/kicad-wasm.d.ts"
    },
    "./config": {
      "import": "./src/config/index.mjs",
      "types": "./types/kicad-wasm.d.ts"
    },
    "./specctra": {
      "import": "./src/specctra/index.mjs",
      "types": "./types/kicad-wasm.d.ts"
    }
  },
  "files": [
    "build-wasm-erc/kicad_drc.mjs",
    "build-wasm-erc/kicad_drc.wasm",
    "src/step-export/index.mjs",
    "src/step-export/step-builder.mjs",
    "src/config/index.mjs",
    "src/specctra/index.mjs",
    "types/kicad-wasm.d.ts"
  ],
  "scripts": {
    "build:release": "node ../scripts/build-releases.mjs",
    "serve": "node ../serve-local.mjs",
    "test": "node test/test-erc-suite.mjs",
    "test:all": "npm run test && npm run test:drc-config && npm run test:specctra",
    "test:erc": "node test/test-erc.mjs",
    "test:erc-hierarchical": "node test/test-erc-hierarchical.mjs",
    "test:step-geometry": "node test/test-step-geometry.mjs",
    "test:step-export": "node test/test-step-export.mjs",
    "test:step-e2e": "node test/test-step-e2e.mjs",
    "test:step-parity": "node test/test-step-parity.mjs",
    "test:step-native": "node test/test-native-step.mjs",
    "test:step-native-parity": "node test/test-step-native-parity.mjs",
    "test:3d-model": "node test/test-3d-model.mjs",
    "test:drc-config": "node test/test-drc-config.mjs",
    "test:erc-config": "node test/test-erc-config.mjs",
    "test:drc-severity": "node test/test-drc-severity.mjs",
    "test:netclass-config": "node test/test-netclass-config.mjs",
    "test:netclass-priority": "node test/test-netclass-priority.mjs",
    "test:manufacturer-rules": "node test/test-manufacturer-rules.mjs",
    "test:config-persistence": "node test/test-config-persistence.mjs",
    "test:invalid-json": "node test/test-invalid-json.mjs",
    "test:partial-config": "node test/test-partial-config.mjs",
    "test:specctra": "node test/test-specctra.mjs",
    "test:specctra-ses": "node test/test-specctra-ses.mjs"
  },
  "license": "GPL-3.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
