(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "8.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user "B.Mask")
    (39 "F.Mask" user "F.Mask")
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")
  (net 3 "SIG1")
  (net 4 "SIG2")

  (footprint "TestPads" (layer "F.Cu")
    (tstamp a0000001-0001-0001-0001-000000000001)
    (at 100 80)
    (property "Reference" "J1")
    (property "Value" "TestPads")
    (attr smd)
    (fp_text reference "J1" (at 0 -2) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at 3 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "VCC"))
    (pad "3" smd rect (at 6 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SIG1"))
    (pad "4" smd rect (at 9 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "SIG2"))
  )

  (footprint "TestPads" (layer "F.Cu")
    (tstamp a0000002-0002-0002-0002-000000000002)
    (at 100 120)
    (property "Reference" "J2")
    (property "Value" "TestPads")
    (attr smd)
    (fp_text reference "J2" (at 0 -2) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at 3 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "VCC"))
    (pad "3" smd rect (at 6 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SIG1"))
    (pad "4" smd rect (at 9 0) (size 1 1) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "SIG2"))
  )

  (segment (start 100 80.5) (end 100 119.5) (width 0.1) (layer "F.Cu") (net 1))
  (segment (start 103 80.5) (end 103 119.5) (width 0.15) (layer "F.Cu") (net 2))
  (segment (start 106 80.5) (end 106 119.5) (width 0.2) (layer "F.Cu") (net 3))
  (segment (start 109 80.5) (end 109 119.5) (width 0.25) (layer "F.Cu") (net 4))

  (via (at 100 95) (size 0.4) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1))
  (via (at 103 95) (size 0.5) (drill 0.25) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 106 95) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 3))

  (segment (start 112 85) (end 112 115) (width 0.15) (layer "F.Cu") (net 3))
  (segment (start 112.25 85) (end 112.25 115) (width 0.15) (layer "F.Cu") (net 4))

  (segment (start 114 85) (end 114 115) (width 0.15) (layer "F.Cu") (net 1))
  (segment (start 114.3 85) (end 114.3 115) (width 0.15) (layer "F.Cu") (net 2))

  (segment (start 95.2 90) (end 95.2 110) (width 0.2) (layer "F.Cu") (net 3))

  (gr_rect (start 95 78) (end 116 122) (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
)
